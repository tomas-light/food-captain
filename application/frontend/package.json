{
  "name": "@food-captain/frontend",
  "type": "module",
  "scripts": {
    "dev": "concurrently 'yarn:locale:watch' 'yarn:vite:dev' 'yarn:types:watch'",
    "vite:dev": "vite",
    "build": "yarn locale:generate && yarn vite:build && yarn types:build",
    "vite:build": "vite build",
    "types:build": "tsc --noEmit",
    "types:watch": "tsc --watch",
    "/": "",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "//": "",
    "locale:watch": "tsx i18n/watch.ts",
    "locale:generate": "tsx i18n/build.ts"
  },
  "dependencies": {
    "i18next": "25.3.2",
    "i18next-browser-languagedetector": "8.2.0",
    "i18next-resources-for-ts": "1.6.0",
    "i18next-resources-to-backend": "1.2.1",
    "nice-web-routes": "2.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "15.6.0",
    "react-router": "7.7.0"
  },
  "devDependencies": {
    "@babel/plugin-syntax-import-attributes": "7.27.1",
    "@tomas-light/stylelint-config-idiomatic-order": "1.0.1",
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.0",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "glob": "^11.0.3",
    "globals": "^16.3.0",
    "sass": "1.89.2",
    "stylelint": "^16.22.0",
    "stylelint-config-css-modules": "4.5.1",
    "stylelint-config-standard": "38.0.0",
    "stylelint-config-standard-scss": "15.0.1",
    "stylelint-order": "7.0.0",
    "ts-loader": "9.5.2",
    "tsx": "4.20.3",
    "typescript": "^5.8.3",
    "vite": "7.0.5",
    "vite-plugin-pretty-module-classnames": "1.4.1",
    "vite-plugin-readable-classnames": "^1.5.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "3.2.4",
    "yenv": "3.0.1"
  }
}
